# Copy to env/ipeot.env and adjust secrets for local dev.
#
# Postgres: shared digi_postgres_db (published on host as 5490).
# From IPEOT containers use host.docker.internal + 5490 (same pattern as ADB crudservice/env_test).
# Alternative: DEV_DB_HOST=digi_postgres_db  DEV_DB_PORT=5432  (requires digi_net; no host gateway).

DEV_DB_HOST=host.docker.internal
DEV_DB_PORT=5490
DEV_DB_USER=digi_user
DEV_DB_PASSWORD=digi_password
DEV_DB_NAME=ipeot
DEV_DB_SSL=false

# HTTP listen port for ipeot-crudservice (must match compose 3034, not ADB 3033)
DEV_PORT=3034

SESSION_SECRET=change-me-ipeot-session-secret-min-32-chars
NODE_ENV=development
CORS_RELAXED=true

# Leave LDAP_URL empty to use the local password seed (CPF 100001-100007 / Ipeot@123).
# LDAP_URL=ldaps://ad.example.local:636
# LDAP_BASE_DN=DC=example,DC=local
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(sAMAccountName={{username}})
# LDAP_UPN_SUFFIX=example.local
